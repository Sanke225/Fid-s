# Copier ce fichier en .env et remplacer les valeurs. Ne jamais committer .env.

# Postgres de la plateforme (comptes, projets, livraisons, paiements)
DATABASE_URL="postgresql://recette:recette@localhost:5432/recette?schema=public"

# Compte d'administration du Postgres des espaces (une base par démo / espace client) — lu par le worker seul
TENANT_DATABASE_ADMIN_URL="postgresql://recette_admin:recette_admin@localhost:5433/postgres"

# Domaine principal ; les démos (*.demo.) et les espaces clients (*.app.) en dérivent
BASE_DOMAIN="localhost"

# Clé maîtresse du chiffrement par enveloppe (32 octets en base64) : openssl rand -base64 32
MASTER_KEY=""

# Envoi des e-mails (Mailpit en développement)
SMTP_URL="smtp://localhost:1025"

# Better Auth : secret de signature (openssl rand -base64 32) et adresse publique de l'app
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Connexion Google : https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
