// Projets, livraisons et historique (bloc 1). deliveries.status n'est écrit QUE par core.transition().

enum DeliveryStatus {
  draft
  building
  build_failed
  demo_ready
  // Le client a payé le dev (dépôt confirmé) ; il doit encore régler les frais de service Fid’s (5 %).
  // La démo reste consultable, rien n'est remis.
  fee_pending
  // Dev payé ET frais Fid’s confirmés : la passation peut commencer.
  paid
  handing_over
  handover_failed
  delivered
  expired
  cancelled

  @@map("delivery_status")
}

// Cycle de vie du projet, vu à l'identique par le dev et par le client assigné.
// La livraison (paiement, passation) commence quand le projet est assigné.
enum ProjectStatus {
  unassigned
  assigned
  // Le dev a cliqué « Début du développement » : le client doit choisir son nom de domaine.
  in_progress
  // Le dev a cliqué « Terminé » : la démo devient visible pour le client.
  finished

  @@map("project_status")
}

model Project {
  id                   String              @id @default(uuid())
  ownerId              String              @map("owner_id")
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name                 String
  description          String?
  // N'est écrit QUE par core/projects.ts.
  status               ProjectStatus       @default(unassigned)
  clientUserId         String?             @map("client_user_id")
  clientUser           User?               @relation("ProjectClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  // Dépôt GitHub relié (lecture seule, via l'installation GitHub App du dev) : « Importer le dernier commit ».
  githubInstallationId String?             @map("github_installation_id")
  githubInstallation   GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  githubRepo           String?             @map("github_repo")
  githubBranch         String?             @map("github_branch")
  assignedAt           DateTime?           @map("assigned_at") @db.Timestamptz
  startedAt            DateTime?           @map("started_at") @db.Timestamptz
  finishedAt           DateTime?           @map("finished_at") @db.Timestamptz
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  deliveries Delivery[]

  @@index([ownerId])
  @@index([clientUserId])
  @@map("projects")
}

model Delivery {
  id                String         @id @default(uuid())
  projectId         String         @map("project_id")
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Jeton du lien de livraison https://DOMAINE/l/<publicToken>
  publicToken       String         @unique @map("public_token")
  status            DeliveryStatus @default(draft)
  // Entier en FCFA, >= 100 (vérifié dans le code).
  amountXof         Int            @map("amount_xof")
  includeSource     Boolean        @default(true) @map("include_source")
  clientName        String         @map("client_name")
  clientEmail       String?        @map("client_email")
  clientPhone       String?        @map("client_phone")
  // Compte du client s'il en a un ; sinon il passe par le lien seul.
  clientUserId      String?        @map("client_user_id")
  clientUser        User?          @relation("DeliveryClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  // Posé à la passation : donne accès à l'espace client sans compte.
  clientAccessToken String?        @unique @map("client_access_token")
  currentBuildId    String?        @unique @map("current_build_id")
  currentBuild      Build?         @relation("DeliveryCurrentBuild", fields: [currentBuildId], references: [id], onDelete: SetNull)
  failureCode       String?        @map("failure_code")
  failureMessage    String?        @map("failure_message")
  expiresAt         DateTime?      @map("expires_at") @db.Timestamptz
  paidAt            DateTime?      @map("paid_at") @db.Timestamptz
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  events         Event[]
  sourceArchives SourceArchive[]
  envVars        DeliveryEnvVar[]
  builds         Build[]          @relation("DeliveryBuilds")
  spaces         Space[]
  payments       Payment[]
  platformFees   PlatformFee[]
  tickets        Ticket[]
  handover       Handover?
  invoice        Invoice?

  @@index([projectId])
  @@index([clientUserId])
  @@index([status])
  @@map("deliveries")
}

// Journal des faits (domaine.verbe_au_passé). L'historique affiché au dev est la lecture de cette table.
model Event {
  id           String    @id @default(uuid())
  deliveryId   String    @map("delivery_id")
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  type         String
  payload      Json      @default("{}")
  // "user:<id>", "system", "admin:<id>"…
  actor        String
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  // Nul tant que l'événement n'a pas été diffusé aux abonnés (rattrapage au redémarrage).
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz

  @@index([deliveryId, occurredAt])
  @@index([dispatchedAt])
  @@map("events")
}

// Installation de la GitHub App de Fid’s sur un compte (personnel ou organisation) du dev.
// Vérifiée à la connexion : l'installation doit être visible par le compte GitHub du dev (jamais un simple numéro reçu).
model GithubInstallation {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId BigInt   @unique @map("installation_id")
  accountLogin   String   @map("account_login")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  projects Project[]

  @@index([userId])
  @@map("github_installations")
}
